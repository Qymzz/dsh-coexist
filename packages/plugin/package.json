{
  "name": "dsh-coexist-plugin",
  "version": "0.1.2",
  "description": "A control center for DSH plugins: coexistence, dependencies, conflicts, rollback, routing and tool policies. · DSH 插件控制中心：冲突插件同时保留，依赖、冲突、回滚、路由和工具策略一处管理。",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src",
    "lib",
    "assets",
    "cordis.patch.yml"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "compatibility",
    "coexistence"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qymzz/dsh-coexist.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/Qymzz/dsh-coexist#readme",
  "dependencies": {
    "dsh-coexist-cli": "^0.1.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
